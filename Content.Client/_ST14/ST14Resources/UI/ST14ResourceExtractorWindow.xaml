<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:ui="clr-namespace:Content.Client._ST14.ST14Resources.UI"
    Resizable="False"
    MinSize="600 320"
    SetSize="600 320">
    <BoxContainer Orientation="Horizontal" Margin="10" HorizontalExpand="True" VerticalExpand="True">

        <PanelContainer Name="Slot1Panel" MinWidth="150">
            <BoxContainer Orientation="Vertical" Margin="8">
                <ui:ST14ResourceGauge Name="Slot1Gauge" MinSize="100 170" HorizontalAlignment="Center" />
                <Label Name="Slot1Label" HorizontalAlignment="Center" />
                <Button Name="Slot1Button" MinWidth="110" HorizontalAlignment="Center" Margin="0 4 0 0" />
            </BoxContainer>
        </PanelContainer>

        <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalAlignment="Center" Margin="10 0">
            <RichTextLabel Name="StatusLabel" HorizontalAlignment="Center" />
            <Label Name="RateLabel" HorizontalAlignment="Center" />
            <Label Text="{Loc 'st14-extractor-ui-feed'}" HorizontalAlignment="Center" Margin="0 12 0 2" />
            <BoxContainer Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Name="FeedSlot1Button" Text="{Loc 'st14-extractor-ui-feed-slot-1'}" Margin="0 0 2 0" />
                <Button Name="FeedSlot2Button" Text="{Loc 'st14-extractor-ui-feed-slot-2'}" Margin="2 0 0 0" />
            </BoxContainer>
            <CheckBox Name="AutoSwitchCheckBox" Text="{Loc 'st14-extractor-ui-auto-switch'}" HorizontalAlignment="Center" Margin="0 6 0 0" />
            <Button Name="ToggleButton" MinWidth="140" HorizontalAlignment="Center" Margin="0 12 0 0" />
        </BoxContainer>

        <PanelContainer Name="Slot2Panel" MinWidth="150">
            <BoxContainer Orientation="Vertical" Margin="8">
                <ui:ST14ResourceGauge Name="Slot2Gauge" LabelsOnLeft="True" MinSize="100 170" HorizontalAlignment="Center" />
                <Label Name="Slot2Label" HorizontalAlignment="Center" />
                <Button Name="Slot2Button" MinWidth="110" HorizontalAlignment="Center" Margin="0 4 0 0" />
            </BoxContainer>
        </PanelContainer>

    </BoxContainer>
</controls:FancyWindow>
